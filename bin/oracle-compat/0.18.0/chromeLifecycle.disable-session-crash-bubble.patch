+export async function prepareCopiedProfileStartup(config, userDataDir) {
+    if (!config.copyProfileSource) return;
+    const root = await realpath(userDataDir);
+    const source = await realpath(config.copyProfileSource);
+    const relative = path.relative(source, root);
+    if (!relative || (!relative.startsWith(`..${path.sep}`) && relative !== '..' && !path.isAbsolute(relative))) {
+        throw new Error('Refusing startup changes inside the source login profile');
+    }
+    const profile = config.chromeProfile || 'Default';
+    if (path.basename(profile) !== profile || profile === '.' || profile === '..') {
+        throw new Error('Invalid copied Chrome profile directory');
+    }
+    const directory = path.join(root, profile);
+    const target = path.join(directory, 'Preferences');
+    if ((await realpath(directory)) !== directory) throw new Error('Copied profile must not redirect');
+    let raw;
+    try {
+        if (!(await lstat(target)).isFile() || (await lstat(target)).isSymbolicLink()) throw new Error('Invalid copied Preferences');
+        raw = await readFile(target, 'utf8');
+    } catch (error) { if (error.code === 'ENOENT') return; throw error; }
+    const preferences = JSON.parse(raw);
+    if (!preferences || typeof preferences !== 'object' || Array.isArray(preferences)) throw new Error('Invalid copied Preferences');
+    for (const key of ['profile', 'session']) {
+        if (preferences[key] !== undefined && (!preferences[key] || typeof preferences[key] !== 'object' || Array.isArray(preferences[key]))) throw new Error('Invalid copied startup preferences');
+    }
+    preferences.profile = { ...preferences.profile, exit_type: 'Normal', exited_cleanly: true };
+    preferences.session = { ...preferences.session, restore_on_startup: 5, startup_urls: [] };
+    const temporary = `${target}.oracle-startup-${process.pid}.tmp`;
+    await writeFile(temporary, JSON.stringify(preferences), { encoding: 'utf8', flag: 'wx' });
+    try { await rename(temporary, target); }
+    catch (error) { await rm(temporary, { force: true }); throw error; }
